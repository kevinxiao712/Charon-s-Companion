--- !u!1001 &719559591
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 2351826081675268906, guid: 375c67779f25c134e8c15cb5bc40f2d7, type: 3}
      propertyPath: m_UiScaleMode
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3638825592496283506, guid: 375c67779f25c134e8c15cb5bc40f2d7, type: 3}
      propertyPath: m_text
      value: "Dear Daisy, \r\nI don\u2019t even know if I deserve to write this.
        But I have to.\r\nI\u2019m sorry. I should have written more. I should have
        been there. I let life get in the way, and I thought I had more time. I thought
        I could fix it. I thought we had forever.\r\nI keep reading your last letter.
        You missed me. And I wasn\u2019t there.\r\nI don\u2019t know how to fix this.
        I don\u2019t know if I ever can. But if you can hear me somehow\u2014if you\u2019re
        still listening\u2014I just want you to know that I love you. I always did.
        I always will.\r\nI\u2019m sorry.\r\nChrys\r\n"
      objectReference: {fileID: 0}
