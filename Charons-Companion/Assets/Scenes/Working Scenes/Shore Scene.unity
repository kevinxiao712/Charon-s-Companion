      objectReference: {fileID: 0}
    - target: {fileID: 2020145425260319168, guid: 4950bd2533b8fbb49b8989efee292f6a, type: 3}
      propertyPath: letterPanel
      value: 
      objectReference: {fileID: 198321743}
    - target: {fileID: 2020145425260319168, guid: 4950bd2533b8fbb49b8989efee292f6a, type: 3}
