      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 2020145425260319168, guid: 4950bd2533b8fbb49b8989efee292f6a, type: 3}
      propertyPath: letterMessage
      value: "Dear Chrys,\r\n\r\nI miss you already, It\u2019s only been a few days,
        but it feels like forever since I last saw you. The new house is nice, bigger
        than our old one, and my room has this huge window that lets in a ton of
        light. You would love it! I finally finished unpacking and guess what? The
        very first thing I put up was that silly photo of us from the beach last
        summer. You know, the one where we were soooo sunburnt? I figured I\u2019d
        need a little piece of home here.\r\n\r\nSchool starts next week and I\u2019m
        nervous but excited. I promise to write and tell you everything, so you better
        write back okay? We\u2019re not going to be those people who drift apart
        just because we're not in the same place. No way!\r\n\r\nWrite soon. Tell
        me everything!\r\n\r\nLove, \r\nDaisy\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 2020145425260319168, guid: 4950bd2533b8fbb49b8989efee292f6a, type: 3}
      propertyPath: descriptionText
      value: 
      objectReference: {fileID: 1979372582}
