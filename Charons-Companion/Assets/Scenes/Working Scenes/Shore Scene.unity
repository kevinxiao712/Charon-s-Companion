      value: 
      objectReference: {fileID: 198321743}
    - target: {fileID: 831805394470804104, guid: a1b4ba2a978d65a469808846d57e9823, type: 3}
      propertyPath: letterMessage
      value: "Dear Chrys,\n\r\nI don\u2019t know how to say this, but Daisy would
        have wanted you to know. She passed away last week in an accident. She was
        walking home from work when a car ran a red light. It was sudden. We\u2019re
        still trying to make sense of it.\n\r\nShe talked about you all the time.
        Even when she hadn\u2019t heard from you in a while, she still wrote letters.
        She kept every one you sent, tucked away like something precious.\n\r\nI
        don\u2019t know what happened between you two, but I do know she never stopped
        caring about you. She loved you, Chrys. She always did.\n\r\nI'm so so sorry,\r\nMonica\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 831805394470804104, guid: a1b4ba2a978d65a469808846d57e9823, type: 3}
